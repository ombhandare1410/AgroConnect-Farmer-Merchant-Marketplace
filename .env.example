# AgroConnect environment variables  (placeholders only - never commit real values)
# Spring Boot does NOT read a ".env" file by itself. Set these as operating-system environment
# variables (see README "Run it"), or put them in your IDE's run configuration.

DB_USERNAME=root
DB_PASSWORD=change_me

# Optional: creates the first administrator at startup (nobody can register as admin).
# Use a strong password of 8+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_too
